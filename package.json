{
  "name": "my-helpdesk-e2e-testing",
  "version": "1.0.0",
  "description": "Multi-tenant helpdesk (JavaScript, REST API, SQLite) for AI-assisted QA: Claude Code + MCP checks UI, API and database per tenant.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "DEMO_DEFECTS=on node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:demo": "DEMO_DEFECTS=on playwright test",
    "eval:replies": "node scripts/eval-replies.js",
    "mcp:qa-tools": "node mcp/qa-tools-server.js",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
